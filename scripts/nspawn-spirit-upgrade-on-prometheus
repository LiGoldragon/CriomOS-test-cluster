#!/usr/bin/env bash
set -euo pipefail

# Operator e2e runner for the Spirit nspawn migration/configuration smoke.
# Pushes main, asks Prometheus to build this flake's
# spirit-nspawn-toplevel, boots it with criomos-nspawn, runs the
# in-container Domain::All migration/config runner, then removes the transient
# machine. The file/app name is historical.

host="${1:-prometheus.goldragon.criome}"
record_count="${SPIRIT_NSPAWN_RECORD_COUNT:-10}"

jj git push --bookmark main

# shellcheck disable=SC2029
ssh "$host" 'bash -s' "$record_count" <<'REMOTE'
set -euo pipefail

record_count="$1"
machine="spirit-upg"
repo="github:LiGoldragon/CriomOS-test-cluster"

cleanup() {
  criomos-nspawn terminate "$machine" >/dev/null 2>&1 || true
  criomos-nspawn remove "$machine" >/dev/null 2>&1 || true
}

printf 'runner user: %s\n' "$(whoami)"
printf 'runner groups: %s\n' "$(groups)"
command -v criomos-nspawn

system_path="$(nix --option max-jobs 0 build "$repo#spirit-nspawn-toplevel" --refresh --no-link --print-out-paths -L)"
printf 'built spirit nspawn system: %s\n' "$system_path"

cleanup
trap cleanup EXIT

criomos-nspawn create "$machine" "$system_path"
criomos-nspawn start "$machine"

for attempt in $(seq 1 30); do
  if criomos-nspawn shell "$machine" hostname >/tmp/spirit-nspawn-hostname 2>/tmp/spirit-nspawn-hostname.err; then
    break
  fi
  if [ "$attempt" -eq 30 ]; then
    cat /tmp/spirit-nspawn-hostname.err >&2 || true
    exit 1
  fi
  sleep 1
done

printf 'container hostname: %s\n' "$(cat /tmp/spirit-nspawn-hostname)"
criomos-nspawn status "$machine"
criomos-nspawn ip "$machine"

if ! timeout 45 criomos-nspawn shell "$machine" systemctl is-system-running --wait; then
  criomos-nspawn shell "$machine" systemctl --failed --no-pager || true
  exit 1
fi

printf 'invoking spirit-upgrade-test-runner inside container with N=%s\n' "$record_count"
criomos-nspawn shell "$machine" spirit-upgrade-test-runner "$record_count"

printf 'spirit nspawn migration/config smoke passed\n'
REMOTE
