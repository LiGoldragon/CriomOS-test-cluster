#!/usr/bin/env bash
set -euo pipefail

host="${1:-prometheus.goldragon.criome}"
branch="${2:-main}"
owner_repo="LiGoldragon/CriomOS-test-cluster"

if ! revision="$(jj log -r "$branch" --no-graph -T 'commit_id')"; then
  printf 'unknown fixture review bookmark: %s\n' "$branch" >&2
  exit 2
fi

jj git push --bookmark "$branch"

ssh "$host" bash -s -- "$owner_repo" "$branch" "$revision" <<'REMOTE'
set -euo pipefail

owner_repo="$1"
branch="$2"
revision="$3"
repo="github:${owner_repo}/${revision}"
sandbox="$(mktemp -d -t criomos-test-cluster.XXXXXX)"
unit="criomos-test-cluster-$(date +%s)-$$"
mkdir -p \
  "$sandbox/home" \
  "$sandbox/work" \
  "$sandbox/state/cache" \
  "$sandbox/state/config" \
  "$sandbox/state/data" \
  "$sandbox/artifacts"

cat >"$sandbox/artifacts/run.nota" <<EOF
(CriomOSTestClusterRun
  (Repo "$repo")
  (Branch "$branch")
  (Revision "$revision")
  (Sandbox "$sandbox")
  (Unit "$unit"))
EOF

if ! systemd-run \
    --user \
    --wait \
    --collect \
    --service-type=exec \
    --unit="$unit" \
    --pipe \
    --setenv=PATH=/run/current-system/sw/bin \
    --setenv=HOME="$sandbox/home" \
    --setenv=XDG_CACHE_HOME="$sandbox/state/cache" \
    --setenv=XDG_CONFIG_HOME="$sandbox/state/config" \
    --setenv=XDG_DATA_HOME="$sandbox/state/data" \
    --property=PrivateUsers=yes \
    --property=ProtectHome=tmpfs \
    --property=WorkingDirectory="$sandbox/work" \
    --property=ReadWritePaths="$sandbox" \
    -- \
    nix flake check "$repo" --refresh --print-build-logs --show-trace; then
  journalctl --user -u "$unit.service" -n 300 --no-pager \
    > "$sandbox/artifacts/journal.txt" || true
  cat "$sandbox/artifacts/journal.txt" >&2 || true
  exit 1
fi

printf 'criomos-test-cluster prometheus sandbox passed: %s\n' "$sandbox"
REMOTE
