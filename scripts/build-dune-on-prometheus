#!/usr/bin/env bash
set -euo pipefail

host="${1:-prometheus.goldragon.criome}"

jj git push --bookmark main

ssh "$host" 'bash -s' <<'REMOTE'
set -euo pipefail

repo="github:LiGoldragon/CriomOS-test-cluster"
sandbox="$(mktemp -d -t criomos-test-cluster-build.XXXXXX)"
unit="criomos-test-cluster-build-dune-$(date +%s)-$$"
mkdir -p \
  "$sandbox/home" \
  "$sandbox/work" \
  "$sandbox/state/cache" \
  "$sandbox/state/config" \
  "$sandbox/state/data" \
  "$sandbox/artifacts"

if ! systemd-run \
    --user \
    --wait \
    --collect \
    --service-type=exec \
    --unit="$unit" \
    --pipe \
    --setenv=PATH=/run/current-system/sw/bin \
    --setenv=HOME="$sandbox/home" \
    --setenv=XDG_CACHE_HOME="$sandbox/state/cache" \
    --setenv=XDG_CONFIG_HOME="$sandbox/state/config" \
    --setenv=XDG_DATA_HOME="$sandbox/state/data" \
    --property=PrivateUsers=yes \
    --property=ProtectHome=tmpfs \
    --property=WorkingDirectory="$sandbox/work" \
    --property=ReadWritePaths="$sandbox" \
    -- \
    nix build "$repo#dune-toplevel" --refresh --print-build-logs --no-link; then
  journalctl --user -u "$unit.service" -n 300 --no-pager \
    > "$sandbox/artifacts/journal.txt" || true
  cat "$sandbox/artifacts/journal.txt" >&2 || true
  exit 1
fi

printf 'criomos-test-cluster dune toplevel build passed: %s\n' "$sandbox"
REMOTE
